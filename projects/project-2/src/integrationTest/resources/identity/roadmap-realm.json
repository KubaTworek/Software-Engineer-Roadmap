{
  "realm": "roadmap",
  "id": "roadmap",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "roadmap-user",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost/*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "ticketing-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticketing-api",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic"
      ]
    },
    {
      "clientId": "roadmap-service",
      "secret": "local-service-secret-not-for-production",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "ticketing-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticketing-api",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "internal",
        "ops"
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111aaa",
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-alice-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222bbb",
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Example",
      "email": "bob@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-bob-password",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "internal",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ops",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
