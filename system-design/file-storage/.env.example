DB_URL=jdbc:postgresql://localhost:5432/filestorage
DB_USERNAME=filestorage
DB_PASSWORD=filestorage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=file-storage
JWT_SECRET=change-this-secret-to-at-least-32-characters-long

PUBLIC_BASE_URL=http://localhost:8080

# Stage 6 production options
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CDN_ENABLED=false
CDN_BASE_URL=
CDN_SIGNED_URL_TTL_SECONDS=300
ANTIVIRUS_ENABLED=false
ANTIVIRUS_MODE=NOOP
CLAMD_HOST=localhost
CLAMD_PORT=3310
THUMBNAILS_ENABLED=true
THUMBNAIL_MAX_WIDTH=320
THUMBNAIL_MAX_HEIGHT=320
OUTBOX_PUBLISH_FIXED_DELAY_MS=5000
OUTBOX_MAX_ATTEMPTS=5
PROCESSING_WORKER_FIXED_DELAY_MS=10000
GC_WORKER_FIXED_DELAY_MS=300000
BACKUP_LOCAL_DIR=/tmp/file-storage-backups
LOCAL_KMS_MASTER_KEY=change-this-local-dev-master-key-32
